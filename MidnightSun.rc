// MidnightSun.rc -- uygulama ikonu + sürüm bilgisi.
// Manifest (DPI farkındalığı) MidnightSun.manifest üzerinden CMake/mt ile
// bağlayıcı manifestine karışır; burada RT_MANIFEST tanımlamayın (çakışır).

#include <winres.h>
#include "resource.h"

IDI_APPICON ICON "app.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION    1,0,0,0
 PRODUCTVERSION 1,0,0,0
 FILEFLAGSMASK  VS_FFI_FILEFLAGSMASK
 FILEFLAGS      0x0L
 FILEOS         VOS_NT_WINDOWS32
 FILETYPE       VFT_APP
 FILESUBTYPE    VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "041f04e6" // Türkçe, Unicode
        BEGIN
            VALUE "CompanyName",      "MidnightSun"
            VALUE "FileDescription",  "MidnightSun — düşük gecikmeli oyun yayını"
            VALUE "FileVersion",      "1.0.0.0"
            VALUE "InternalName",     "MidnightSun"
            VALUE "LegalCopyright",   "© 2026 MidnightSun"
            VALUE "OriginalFilename", "MidnightSun.exe"
            VALUE "ProductName",      "MidnightSun"
            VALUE "ProductVersion",   "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x41f, 1254
    END
END
